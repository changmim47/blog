{
  "name": "daily-memorylog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "//prebuild": "sitemap/rss/robots는 dynamic='force-static'이라 fetch 기본값이 force-cache가 된다. Render가 .next/cache를 복원하면 지난 빌드의 Supabase 응답이 재사용되어 새 글이 사이트맵에서 누락된다. 데이터 캐시만 비우고 컴파일 캐시는 남긴다.",
    "prebuild": "node -e \"require('fs').rmSync('.next/cache/fetch-cache',{recursive:true,force:true})\"",
    "build": "next build",
    "preview": "npx --yes serve out",
    "generate-post": "tsx scripts/generate-post.ts",
    "refresh-trending": "tsx scripts/refresh-trending-topics.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "2",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "dotenv": "^17.4.2",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2"
  }
}
